{
  "name": "@shawcx/avispa",
  "version": "2.0.0",
  "description": "Draw node/link graphs in SVG and drag, pan, zoom, and collapse them; Backbone views with an optional WebSocket feed",
  "keywords": [
    "svg",
    "graph",
    "network",
    "diagram",
    "backbone",
    "websocket"
  ],
  "main": "js/Avispa.js",
  "sass": "scss/Avispa.scss",
  "style": "css/Avispa.css",
  "files": [
    "js",
    "css",
    "scss"
  ],
  "scripts": {
    "build": "npx sass scss/Avispa.scss css/Avispa.css",
    "example": "npm --prefix example install && npm --prefix example start",
    "test": "playwright test",
    "pretest": "npm --prefix example install --no-audit --no-fund && npm --prefix example run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawcx/avispa.git"
  },
  "author": "Matthew Shaw",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shawcx/avispa/issues"
  },
  "homepage": "https://github.com/shawcx/avispa#readme",
  "peerDependencies": {
    "backbone": "^1.4.1",
    "jquery": "^3.6.3 || ^4.0.0",
    "underscore": "^1.13.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "backbone": "^1.4.1",
    "jquery": "^3.6.3 || ^4.0.0",
    "sass": "^1.106.1",
    "underscore": "^1.13.6"
  }
}
