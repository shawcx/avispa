{
  "name": "@shawcx/avispa",
  "version": "1.0.0",
  "description": "SVG + Websockets",
  "main": "js/Avispa.js",
  "sass": "scss/Avispa.scss",
  "style": "css/Avispa.css",
  "files": [
    "js",
    "css",
    "scss"
  ],
  "scripts": {
    "build": "npx sass scss/Avispa.scss css/Avispa.css",
    "example": "npm --prefix example install && npm --prefix example start",
    "test": "playwright test",
    "pretest": "npm --prefix example install --no-audit --no-fund && npm --prefix example run build",
    "publish:skunk": "SKUNK_NPM_TOKEN=$(glab config get token --host code.skunk.tools) npm publish --@shawcx:registry=https://code.skunk.tools/api/v4/projects/69/packages/npm/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawcx/avispa.git"
  },
  "author": "Matthew Shaw",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shawcx/avispa/issues"
  },
  "homepage": "https://github.com/shawcx/avispa#readme",
  "peerDependencies": {
    "backbone": "^1.4.1",
    "jquery": "^4.0.0",
    "underscore": "^1.13.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "backbone": "^1.4.1",
    "jquery": "^4.0.0",
    "sass": "^1.58.2",
    "underscore": "^1.13.6"
  }
}
